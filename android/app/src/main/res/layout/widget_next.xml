<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_badge" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Als Nächstes"
            android:textColor="@color/w_ink"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/stand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/w_ink2"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/today_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_soft"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">
        <TextView
            android:id="@+id/today_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Heute · Start: Elektrik erneuern"
            android:textColor="@color/w_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/today_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="bis 11.12. · 6 offene To-dos"
            android:textColor="@color/w_ink2"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/row1_date"
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Fr 20.11."
            android:textColor="@color/w_ink"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/row1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Energieberater beauftragen"
            android:textColor="@color/w_ink"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/row1_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="in 18 T."
            android:textColor="@color/w_ink2"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/row2_date"
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Fr 27.11."
            android:textColor="@color/w_ink"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/row2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Rechnung fällig: Landkreis"
            android:textColor="@color/w_ink"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/row2_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="in 25 T."
            android:textColor="@color/w_ink2"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/row3_date"
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Fr 11.12."
            android:textColor="@color/w_ink"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/row3_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Ende: Elektrik erneuern"
            android:textColor="@color/w_ink"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/row3_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="in 39 T."
            android:textColor="@color/w_ink2"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/row4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/row4_date"
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Di 15.12."
            android:textColor="@color/w_ink"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/row4_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Angebote Wärmepumpe"
            android:textColor="@color/w_ink"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/row4_when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="in 43 T."
            android:textColor="@color/w_ink2"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Öffne die Hausakte einmal – dann stehen hier deine nächsten Termine."
        android:textColor="@color/w_ink2"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
